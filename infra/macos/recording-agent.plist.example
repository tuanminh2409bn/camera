<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.devone.camera.air-recording-supervisor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>-s</string>
        <string>/usr/bin/perl</string>
        <string>__WORKSPACE__/scripts/air_recording_supervisor.pl</string>
        <string>--workspace</string>
        <string>__WORKSPACE__</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WORKSPACE__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>LC_ALL</key>
        <string>C</string>
        <key>LC_CTYPE</key>
        <string>C</string>
        <key>LANG</key>
        <string>C</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <false/>

    <key>Umask</key>
    <integer>63</integer>

    <key>StandardOutPath</key>
    <string>__WORKSPACE__/.local/recording-service/launchd.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__WORKSPACE__/.local/recording-service/launchd.stderr.log</string>
</dict>
</plist>
