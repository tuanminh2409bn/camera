<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.camera.air-maintenance-relay</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/ssh</string><string>-N</string><string>-F</string>
    <string>/Users/macbook/Developer/camera/.local/ssh/maintenance-relay/config</string>
    <string>camera-maintenance</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/Users/macbook/Developer/camera/.local/ssh/maintenance-relay/stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/macbook/Developer/camera/.local/ssh/maintenance-relay/stderr.log</string>
</dict></plist>
