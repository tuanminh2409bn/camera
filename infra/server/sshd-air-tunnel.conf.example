# Install in sshd_config.d only after validating the complete effective sshd config.
# A dedicated Unix account and a dedicated Air key, unrelated to Mini->Air key.
Match User devone-air
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    AllowTcpForwarding remote
    AllowStreamLocalForwarding no
    PermitTunnel no
    PermitListen 127.0.0.1:18554 127.0.0.1:19996
    GatewayPorts no
    PermitTTY no
    X11Forwarding no
    AllowAgentForwarding no
    PermitUserRC no
    MaxSessions 0
Match all
# authorized_keys prefix for the dedicated key:
# restrict,port-forwarding,permitlisten="127.0.0.1:18554",permitlisten="127.0.0.1:19996" ssh-ed25519 PUBLIC_KEY
