{
  "name": "devone-secure-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:contracts": "npm run build -w @devone/contracts",
    "typecheck": "npm run build:contracts && npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json",
    "test": "npm run build:contracts && tsx --test --test-concurrency=1 apps/api/tests/*.test.ts",
    "build": "npm run build:contracts && npm run build -w @devone/api && npm run build -w @devone/web",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "test:browser": "playwright test",
    "dev:web": "npm run dev -w @devone/web",
    "dev:api": "npm run dev -w @devone/api",
    "format:check": "prettier --check 'apps/**/*.{ts,tsx,json,css}' 'packages/**/*.{ts,json}' 'tests/browser/*.ts' 'scripts/*.ts' playwright.config.ts tsconfig.tests.json package.json tsconfig.base.json"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
